{
  "name": "badminton-queue-frontend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:domain && next dev",
    "build:domain": "tsc -p packages/domain/tsconfig.json",
    "build": "npm run build:domain && next build --webpack",
    "start": "next start",
    "typecheck": "npm run build:domain && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests playwright.config.ts next.config.ts --ext .ts,.tsx",
    "test": "npm run build:domain && node --test packages/domain/dist/tests/*.test.js tests/unit/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:domain": "npm run build:domain && node --test packages/domain/dist/tests/*.test.js",
    "test:responsive": "playwright test tests/ui/responsive.spec.ts --workers=1",
    "test:a11y": "playwright test tests/ui/accessibility.spec.ts --workers=1",
    "test:workflows": "playwright test tests/ui/workflows.spec.ts --workers=1",
    "test:visual": "playwright test tests/ui/visual.spec.ts --workers=1",
    "test:visual:update": "playwright test tests/ui/visual.spec.ts --update-snapshots",
    "test:ui-quality": "npm run test:responsive && npm run test:a11y && npm run test:workflows && npm run test:visual",
    "test:ui:debug": "playwright test tests/ui --debug"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@shuttle-queue/domain": "file:packages/domain",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.4",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "serwist": "9.5.12",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
