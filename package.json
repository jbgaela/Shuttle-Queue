{
  "name": "badminton-queue-frontend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:domain && next dev",
    "build:domain": "npm run build --workspace @shuttle-queue/domain",
    "build": "npm run build:domain && next build --webpack",
    "start": "next start",
    "typecheck": "npm run build:domain && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node --test",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:domain": "npm run build:domain && npm run test --workspace @shuttle-queue/domain"
  },
  "dependencies": {
    "@shuttle-queue/domain": "*",
    "@hookform/resolvers": "5.7.1",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14",
    "dexie": "4.4.4"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.12",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "6.0.3",
    "esbuild": "0.28.1",
    "serwist": "9.5.12"
  }
}
